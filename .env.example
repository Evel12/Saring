# All values are required unless noted. No stored fallbacks: the API refuses to
# start without SESSION_SECRET, and AI/calendar/email features stay disabled
# until their provider settings are configured per deployment.

DATABASE_URL=sqlite:///./saring.db
# PostgreSQL for Compose/VPS deployments:
# DATABASE_URL=postgresql+psycopg://saring:saring@db:5432/saring

# Required: at least 32 random characters. Sessions and CSRF depend on it.
SESSION_SECRET=

# Set true (default) when serving over HTTPS. False only for local plain-HTTP testing.
COOKIE_SECURE=true
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Document storage directory. Back this up with the database.
STORAGE_ROOT=./storage

# AI provider (OpenAI-compatible, or local Ollama). AI analysis is disabled until
# a model is configured. An admin can also select provider/base URL/model in the
# Settings UI (the saved server selection wins over these variables).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Optional: ollama runs locally without any API key
# AI_PROVIDER=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# Per-request model timeout in seconds; raise it if a local Ollama model needs
# longer to load into memory and generate structured JSON.
# AI_TIMEOUT_SECONDS=300

# Local OCR only: install Tesseract separately (or run setup-ocr.cmd); no
# images are sent to the AI provider.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANG=eng
# For a conda/micromamba Tesseract installation, point to its share/tessdata directory.
# TESSDATA_PREFIX=E:\Saring\.runtime\ocr\share\tessdata
# URL retrieval is deliberately disabled; there is no enable flag.

# Public HTTPS origin used in candidate links. Required for real email delivery.
PUBLIC_APP_URL=

# Resend key is per organization, kept server-side. Settings stores only from_email.
# SARING_PROVIDER_<ORG_UUID_WITHOUT_DASHES_UPPERCASE>_EMAIL=

# Google OAuth web-client configuration (server and worker only).
# Required for interview calendar coordination; URLs use the HTTPS PUBLIC_APP_URL host.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/api/v1/oauth/google/callback
# Required: a separate Fernet key; generate with cryptography.Fernet.generate_key().
# Do not reuse the session secret or put this key in browser/VITE configuration.
TOKEN_ENCRYPTION_KEY=

# Retention maintenance: dry-run by default; only withdrawn applications qualify.
RETENTION_WITHDRAWN_DAYS=365
# Optional model cost estimate; all three values required, model must match exactly.
# Prices are USD per million provider-reported input/output tokens. No defaults.
MODEL_PRICE_MODEL=
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
