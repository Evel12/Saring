SARING_MODE=demo
# Frontend uses same-origin cookie/CSRF sessions; no browser bearer token or VITE API key is needed.
DATABASE_URL=sqlite:///./saring.db
# Required in LIVE: generate at least 32 random characters. Local DEMO creates an ignored key file.
SESSION_SECRET=
# Set true behind HTTPS. False is only for local HTTP development.
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
STORAGE_ROOT=./storage
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Organization provider tokens are configured in server environment, not submitted from browsers.
# Google Calendar now uses server-side OAuth below; static access tokens do not authorize interview coordination.

# Local OCR only: install Tesseract separately; no images are sent to the AI provider.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANG=eng
# For a conda/micromamba Tesseract installation, point to its share/tessdata directory.
# TESSDATA_PREFIX=E:\Saring\.runtime\ocr\share\tessdata
# URL retrieval is deliberately disabled; there is no enable flag.

# Portal origin: HTTPS is mandatory for live email; local DEMO may use HTTP.
# Leave blank for local CMD defaults (5173) or Compose defaults (8080).
PUBLIC_APP_URL=
# Resend key is per organization, kept server-side. Settings stores only from_email.
# SARING_PROVIDER_<ORG_UUID_WITHOUT_DASHES_UPPERCASE>_EMAIL=

# Google OAuth web-client configuration (server and worker only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/oauth/google/callback
# Required in LIVE: a separate Fernet key; generate with cryptography.Fernet.generate_key().
# Do not reuse the session secret or put this key in browser/VITE configuration.
TOKEN_ENCRYPTION_KEY=

# Retention maintenance: dry-run by default; only withdrawn applications qualify.
RETENTION_WITHDRAWN_DAYS=365
# Optional model cost estimate; all three values required, model must match exactly.
# Prices are USD per million provider-reported input/output tokens. No defaults.
MODEL_PRICE_MODEL=
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
